          {
            "code": "from pydantic import BaseModel, Field",
            "comment": "定义数据模型"
          },
          {
            "code": "",
            "comment": ""
          },
          {
            "code": "class Action(BaseModel):",
            "comment": "定义期望的输出结构"
          },
          {
            "code": "    action: str = Field(description=\"工具名称\")",
            "comment": "字段描述帮助模型理解"
          },
          {
            "code": "    input: str = Field(description=\"工具参数\")",
            "comment": "添加类型和约束"
          },
          {
            "code": "",
            "comment": ""
          },
          {
            "code": "parser = PydanticOutputParser(pydantic_object=Action)",
            "comment": "创建解析器实例"
          },
          {
            "code": "prompt = parser.get_format_instructions()",
            "comment": "自动生成格式说明"
          },
          {
            "code": "result = parser.parse(model_output)",
            "comment": "解析并验证模型输出"
